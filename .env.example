# Caminhos locais do Softwarehouse/Oracle
SOFTWAREHOUSE_WORKSPACE=/home/abel13/.openclaw/workspace/softwarehouse
SOFTWAREHOUSE_PIPELINE=/home/abel13/.openclaw/workspace/softwarehouse/scripts/update_pipeline.sh
SOFTWAREHOUSE_FEEDBACK=/home/abel13/.openclaw/workspace/softwarehouse/data/feedback.json
SOFTWAREHOUSE_OPPORTUNITIES=/home/abel13/.openclaw/workspace/softwarehouse/out/opportunities.feedback.json
SOFTWAREHOUSE_EML_DIR=/mnt/c/Users/abelo/OneDrive/Workspace/Softwarehouse

# Integração automática planejada/importação
# Opção A: usar EMLs locais + pipeline existente (padrão)
AUTO_IMPORT_MODE=eml
AUTO_IMPORT_CRON_SECRET=change-me

# Opção B: Gmail API (preencher no servidor quando OAuth/serviço estiver pronto)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_LABEL_OR_QUERY=from:(99freelas.com.br) newer_than:7d

# Segurança das rotas de escrita/cron em produção
DASHBOARD_API_TOKEN=change-me
