# 99Dashboard com Supabase como fonte de dados
DATA_BACKEND=supabase
SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Runtime temporário usado apenas pelo pipeline/importação.
# Não é fonte de dados e não deve ser versionado.
SOFTWAREHOUSE_WORKSPACE=./.runtime
SOFTWAREHOUSE_PIPELINE=./scripts/update_pipeline.sh
SOFTWAREHOUSE_FEEDBACK=./.runtime/data/feedback.json
SOFTWAREHOUSE_OPPORTUNITIES=./.runtime/out/opportunities.feedback.json
SOFTWAREHOUSE_EML_DIR=./.runtime/emls
SOFTWAREHOUSE_IMPORT_STATE=./.runtime/data/import-state.json

# Precificação
PRICING_HOURLY_RATE=130
PRICING_PLATFORM_FEE_PCT=0.20

# Camada opcional de IA para precificação direcionada ao projeto.
AI_PRICING_ENABLED=false
AI_PRICING_MODEL=gpt-4o-mini
CHAT_AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Integração Gmail
AUTO_IMPORT_MODE=gmail
AUTO_IMPORT_CRON_SECRET=change-me
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_LABEL_OR_QUERY=from:(99freelas.com.br) newer_than:7d

# Segurança das rotas de escrita/cron em produção
DASHBOARD_API_TOKEN=change-me
