# 99Dashboard self-contained
DATA_BACKEND=local
# Para usar Supabase local, rode `npx supabase start` e altere:
# DATA_BACKEND=supabase
# SUPABASE_URL=http://127.0.0.1:55421
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
# SUPABASE_SERVICE_ROLE_KEY=<service_role exibida pelo supabase start>
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key exibida pelo supabase start>
# Por padrão, o app usa ./storage dentro do próprio repositório.
# Só altere estes caminhos se quiser usar um volume/pasta externa no servidor.
SOFTWAREHOUSE_WORKSPACE=./storage
SOFTWAREHOUSE_PIPELINE=./scripts/update_pipeline.sh
SOFTWAREHOUSE_FEEDBACK=./storage/data/feedback.json
SOFTWAREHOUSE_OPPORTUNITIES=./storage/out/opportunities.feedback.json
SOFTWAREHOUSE_EML_DIR=./storage/emls
SOFTWAREHOUSE_IMPORT_STATE=./storage/data/import-state.json

# Precificação
PRICING_HOURLY_RATE=130
PRICING_PLATFORM_FEE_PCT=0.20

# Camada opcional de IA para precificação direcionada ao projeto.
# Se AI_PRICING_ENABLED=false ou OPENAI_API_KEY vazio, o pipeline usa só a heurística local.
AI_PRICING_ENABLED=false
AI_PRICING_MODEL=gpt-4o-mini
CHAT_AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Integração automática planejada/importação
# Opção A: usar EMLs locais + pipeline interno (padrão)
AUTO_IMPORT_MODE=eml
AUTO_IMPORT_CRON_SECRET=change-me

# Opção B: Gmail API (preencher no servidor quando OAuth/refresh token estiver pronto)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_LABEL_OR_QUERY=from:(99freelas.com.br) newer_than:7d

# Segurança das rotas de escrita/cron em produção
DASHBOARD_API_TOKEN=change-me
