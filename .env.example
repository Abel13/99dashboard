# Bootstrap Supabase
DATA_BACKEND=supabase
SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secrets ficam no env/runtime, não no banco
OPENAI_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
DASHBOARD_API_TOKEN=

# Configurações não secretas ficam preferencialmente no menu Configurações/Supabase.
# Estes valores abaixo são apenas fallback inicial antes de salvar settings.
PRICING_HOURLY_RATE=130
PRICING_PLATFORM_FEE_PCT=0.20
AI_PRICING_ENABLED=false
AI_PRICING_MODEL=gpt-4o-mini
CHAT_AI_MODEL=gpt-4o-mini
GMAIL_LABEL_OR_QUERY=from:(99freelas.com.br) newer_than:7d
